rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /admins/{adminId} {
      allow read: if admin();
      allow write: if false;
    }
    match /conversations/{userId} {
      allow create: if owner(userId);
      allow read, update: if owner(userId) || admin();
      allow delete: if admin();
      match /messages/{messageId} {
        allow read: if owner(userId) || admin();
        allow create: if (owner(userId) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == "visitor") || (admin() && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == "admin");
        allow update, delete: if false;
      }
    }
  }
}